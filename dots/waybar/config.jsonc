{
  "layer": "top",
  "position": "top",
  "margin-left": 5,
  "margin-top": 5,
  "margin-right": 5,
  "spacing": 5,

  "modules-left": [
    "custom/logo",
    "group/workspaces"
  ],

  "modules-center": [
    "clock",
    "group/media"
  ],

  "modules-right": [
    "hyprland/language",
    "network",
    "group/volume",
    "group/tray"
  ],

  "group/tray": {
    "orientation": "horizontal",
    "modules": [
      "custom/powermenu",
      "tray"
    ],
    "drawer": {
      "transition-left-to-right": false,
      "transition-duration": 500
    }
  },

  "group/media": {
    "orientation": "horizontal",
    "modules": [
      "cava",
      "mpris"
    ],
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false
    }
  },

  "group/volume": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "pulseaudio/slider"
    ],
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": true
    }
  },

  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/window",
      "hyprland/workspaces"
    ]
  },

  "hyprland/workspaces": {
    "sort-by-name": true,
    "on-click": "activate",
    "format": "{icon}",
    "show-special": true,
    "format-icons": {
      "1": "",
      "2": "",
      "3": "󰎄",
      "4": "",
      "special": ""
    },
    "persistent-workspaces": {
      "*": 3
    }
  }, 
  "hyprland/window": {
    "max-length": 25,
    "separate-outputs": true,
    "format": "{initialTitle}",
    "icon": true,
    "expand": true,
    "icon-size": 20
  },
  "cava": {
    "bars": 16,
    "mode": "pipeware",
    "hide_on_silence": true,
    "stereo": true,
    "sleep_timer": 1
  },
  "mpris": {
    "format": "{player_icon} {artist} - <i>{title}</i>",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "player-icons": {
      "default": "▶",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "⏸"
    },
    "ignored-players": ["firefox"]
  },

  "tray": {
    "icon-size": 14,
    "spacing": 5
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": " {:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month"
    }
  },
  "network": {
    "interval": 2,
    "format": "{ifname}",
    "format-wifi": "󰖩",
    "format-ethernet": "",
    "tooltip-format-wifi": "{essid}"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon} {volume}% {format_source}",
    "format-bluetooth-muted": " {format_source}",
    "format-muted": "  {format_source}",
    "tooltip-format": "{icon} {volume}%",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "🎧",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "pulseaudio/slider": {
    "expand": true,
    "orientation": "horizontal"
  },
  "hyprland/language": {
    "format": " {}",
    "format-ru": "ru",
    "format-en": "en"
  },
  "custom/logo": {
    "format": "󰣇",
    "on-click": "~/.config/wofi/launchers/launcher.sh",
    "tooltip": false
  },
  "custom/powermenu": {
    "format": "⏻",
    "on-click": "dummy-power-menu",
    "tooltip": false
  }
}
